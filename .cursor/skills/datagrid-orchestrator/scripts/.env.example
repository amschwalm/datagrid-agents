# Copy to .env in this folder (never commit the real key).
# The client also honors DATAGRID_API_KEY / Datagrid_API_KEY in the environment
# and a repo-root .env.
DATAGRID_API_KEY=your_api_key_here

# Optional. Default: https://api.datagrid.com/v1
# DATAGRID_API_BASE=https://api.datagrid.com/v1

# Optional. Seconds per converse call (default 3600 = 60 min).
# DATAGRID_CONVERSE_TIMEOUT=3600

# Optional. Home teamspace name or id for Datagrid-Teamspace header.
# DATAGRID_TEAMSPACE_ID=
